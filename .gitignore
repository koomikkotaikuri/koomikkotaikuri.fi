# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# full-resolution source assets (kept locally, not deployed)
/originals

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS/iCloud duplicate copies ("kuva 2.webp") - never referenced by the site
* 2.*

# machine-local Claude Code settings
.claude/settings.local.json

# brainstorming visual companion
.superpowers/
